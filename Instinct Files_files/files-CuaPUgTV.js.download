      ownerName
      createdAt
      generation
      access
      publishedRevisionId
      url
      externalOrigins
      isOwner
    }
    lease {
      token
      runtimeUrl
      expiresAt
      revisionId
      isOwnerUser
      localStorageScope
      localStorageSession
    }
  }
}
